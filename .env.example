# Локальный запуск. На сервере замените origin на HTTPS-адрес и включите Secure.
APP_PORT=8080
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Данные API-пользователя Web Scraper API. Пустые значения оставляют прямой доступ.
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Точный адрес доверенного reverse proxy внутри Docker-сети. Не задавайте *.
FORWARDED_ALLOW_IPS=127.0.0.1
