# Локальный запуск. На сервере замените origin на HTTPS-адрес и включите Secure.
APP_PORT=8080
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# DownSub без API-ключа; direct оставляет прямой youtube-transcript-api.
YOUTUBE_PROVIDER=downsub
# Точный адрес доверенного reverse proxy внутри Docker-сети. Не задавайте *.
FORWARDED_ALLOW_IPS=127.0.0.1
# Необязательная платная генерация иллюстраций; модель выбирает оператор.
IMAGE_GENERATION_ENABLED=false
OPENAI_IMAGE_MODEL=
IMAGE_DAILY_REQUEST_LIMIT=10
IMAGE_BUDGET_TIMEZONE=Europe/Vilnius
